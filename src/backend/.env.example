# Copy to .env beside compose.yml. .env holds Compose settings only; API configuration
# (database, admin password, debug keys, proxy, storage) lives in emapi-config.json.

# Container emapi-config.json, mounted read-only at /run/secrets/emapi-config. Relative
# paths start at compose.yml; the default is the artefacts folder beside the repository.
# Inside a container use host.docker.internal with a TCP port for a database on the host.
EM_API_CONFIG_FILE=../../../.artefacts/EmPorium/config/emapi-config.docker.json

EMPORIUM_API_PORT=5232
EMPORIUM_API_BIND_ADDRESS=127.0.0.1
ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Release
# IANA timezone used for image build and container runtime.
TZ=Asia/Jakarta

# Optional overrides of emapi-config.json values, e.g. from a secret manager.
# EM_DB_CONNECTION_STRING='Server=host.docker.internal,1433;Database=Em;User ID=em;Password=CHANGE_ME;Encrypt=True'
# EM_ADMIN_INITIAL_PASSWORD='CHANGE_ME'
# EM_DB_PROVIDER=MicrosoftSqlServer
# EM_DEBUG_TOKEN=
